      "title": "IdentifierInput",
      "type": "object"
    },
    "InputReference": {
      "additionalProperties": false,
      "properties": {
        "ref": {
          "const": "input",
          "title": "Ref",
          "type": "string"
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*(?![\\s\\S])",
