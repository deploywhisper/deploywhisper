          "type": "string"
        }
      },
      "required": [
        "ref",
        "name"
      ],
      "title": "InputReference",
      "type": "object"
    },
    "IntegerInput": {
      "additionalProperties": false,
      "properties": {
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "default": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default"
        },
        "type": {
          "const": "integer",
          "title": "Type",
          "type": "string"
        },
        "minimum": {
          "default": -9007199254740991,
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "title": "Minimum",
          "type": "integer"
        },
        "maximum": {
          "default": 9007199254740991,
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "title": "Maximum",
          "type": "integer"
        }
      },
      "required": [
        "type"
      ],
      "title": "IntegerInput",
      "type": "object"
    },
    "PolicyEvaluationStep": {
