      "required": [
        "id",
        "depends_on",
        "kind",
        "binding"
      ],
      "title": "HumanDecisionStep",
      "type": "object"
    },
    "IdentifierInput": {
      "additionalProperties": false,
      "properties": {
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
