            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/IdentifierInput"
            },
            {
              "$ref": "#/$defs/CommitShaInput"
            },
            {
              "$ref": "#/$defs/StringInput"
            },
            {
              "$ref": "#/$defs/IntegerInput"
            },
            {
              "$ref": "#/$defs/BooleanInput"
            }
          ]
        }
      },
      "propertyNames": {
        "maxLength": 128,
        "minLength": 1
      },
      "title": "Inputs",
      "type": "object"
    },
    "steps": {
      "items": {
        "discriminator": {
          "mapping": {
            "admitted_collection": "#/$defs/AdmittedCollectionStep",
            "human_decision": "#/$defs/HumanDecisionStep",
            "policy_evaluation": "#/$defs/PolicyEvaluationStep",
            "registered_github_handoff": "#/$defs/RegisteredGithubHandoffStep",
            "shared_analysis": "#/$defs/SharedAnalysisStep",
            "uploaded_intake": "#/$defs/UploadedIntakeStep"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/UploadedIntakeStep"
          },
          {
            "$ref": "#/$defs/AdmittedCollectionStep"
          },
          {
            "$ref": "#/$defs/SharedAnalysisStep"
          },
          {
            "$ref": "#/$defs/PolicyEvaluationStep"
          },
          {
            "$ref": "#/$defs/HumanDecisionStep"
          },
          {
            "$ref": "#/$defs/RegisteredGithubHandoffStep"
          }
        ]
      },
      "maxItems": 50,
      "minItems": 1,
      "title": "Steps",
      "type": "array"
    }
  },
  "required": [
    "workflow_version",
    "project_id",
    "environment",
    "steps"
  ],
  "title": "Workflow",
  "type": "object"
}
