          "const": "uploaded",
          "title": "Kind",
          "type": "string"
        },
        "repository_id": {
          "default": null,
          "title": "Repository Id",
          "type": "null"
        },
        "commit_sha": {
          "default": null,
          "title": "Commit Sha",
          "type": "null"
        },
        "limitation": {
          "const": "Uploaded evidence does not establish repository identity or exact-plan custody.",
          "default": "Uploaded evidence does not establish repository identity or exact-plan custody.",
          "title": "Limitation",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "UploadedSource",
      "type": "object"
