{
  "$defs": {
    "AdmittedCollectionStep": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*(?![\\s\\S])",
          "title": "Id",
          "type": "string"
        },
        "depends_on": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*(?![\\s\\S])",
            "type": "string"
          },
          "maxItems": 50,
          "title": "Depends On",
          "type": "array"
        },
        "kind": {
          "const": "admitted_collection",
          "title": "Kind",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/CollectedSource"
        },
        "parameters": {
          "$ref": "#/$defs/CollectionParameters"
        }
      },
      "required": [
        "id",
        "depends_on",
        "kind",
        "source"
      ],
      "title": "AdmittedCollectionStep",
      "type": "object"
    },
    "BooleanInput": {
      "additionalProperties": false,
      "properties": {
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "default": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default"
        },
        "type": {
          "const": "boolean",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "BooleanInput",
      "type": "object"
    },
    "CollectedSource": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "collected",
          "title": "Kind",
          "type": "string"
        },
        "repository_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*(?![\\s\\S])",
              "type": "string"
            },
            {
              "discriminator": {
                "mapping": {
                  "input": "#/$defs/InputReference",
                  "project": "#/$defs/ProjectReference",
                  "run": "#/$defs/RunReference"
                },
                "propertyName": "ref"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/InputReference"
                },
                {
                  "$ref": "#/$defs/ProjectReference"
                },
                {
                  "$ref": "#/$defs/RunReference"
                }
              ]
            }
          ],
          "title": "Repository Id"
        },
        "commit_sha": {
          "anyOf": [
            {
              "maxLength": 40,
              "minLength": 40,
              "pattern": "^[0-9a-f]{40}(?![\\s\\S])",
              "type": "string"
            },
            {
              "$ref": "#/$defs/InputReference"
            }
          ],
          "title": "Commit Sha"
        },
        "profile_digest": {
          "maxLength": 71,
          "minLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])",
          "title": "Profile Digest",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "repository_id",
        "commit_sha",
        "profile_digest"
      ],
      "title": "CollectedSource",
      "type": "object"
    },
    "CollectionParameters": {
      "additionalProperties": false,
      "properties": {
        "max_artifact_bytes": {
          "anyOf": [
            {
              "maximum": 8388608,
              "minimum": 1,
              "type": "integer"
            },
            {
              "$ref": "#/$defs/InputReference"
            }
          ],
          "default": 8388608,
          "title": "Max Artifact Bytes"
        },
        "timeout_seconds": {
          "anyOf": [
            {
              "maximum": 600,
              "minimum": 1,
              "type": "integer"
            },
            {
              "$ref": "#/$defs/InputReference"
            }
          ],
          "default": 600,
          "title": "Timeout Seconds"
        }
      },
      "title": "CollectionParameters",
      "type": "object"
    },
    "CommitShaInput": {
      "additionalProperties": false,
      "properties": {
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "default": {
          "anyOf": [
            {
              "maxLength": 40,
              "minLength": 40,
              "pattern": "^[0-9a-f]{40}(?![\\s\\S])",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default"
        },
        "type": {
          "const": "commit_sha",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "CommitShaInput",
      "type": "object"
    },
