  "additionalProperties": false,
  "properties": {
    "workflow_version": {
      "const": 2,
      "maximum": 2,
      "minimum": 2,
      "title": "Workflow Version",
      "type": "integer"
    },
    "project_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*(?![\\s\\S])",
      "title": "Project Id",
      "type": "string"
    },
    "workspace_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*(?![\\s\\S])",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Workspace Id"
    },
    "environment": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*(?![\\s\\S])",
          "type": "string"
        },
        {
          "$ref": "#/$defs/InputReference"
        }
      ],
      "title": "Environment"
    },
    "inputs": {
      "additionalProperties": false,
      "maxProperties": 32,
      "patternProperties": {
        "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*(?![\\s\\S])": {
          "discriminator": {
            "mapping": {
              "boolean": "#/$defs/BooleanInput",
              "commit_sha": "#/$defs/CommitShaInput",
              "identifier": "#/$defs/IdentifierInput",
              "integer": "#/$defs/IntegerInput",
              "string": "#/$defs/StringInput"
