{
  "$defs": {
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "default": 1,
          "maximum": 1,
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "step_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Step Id",
          "type": "string"
        },
        "output": {
          "enum": [
            "screened_artifacts",
            "report",
            "action_binding",
            "decision_receipt"
          ],
          "title": "Output",
          "type": "string"
        }
      },
      "required": [
        "step_id",
        "output"
      ],
      "title": "Ref",
      "type": "object"
    },
    "Step": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "default": 1,
          "maximum": 1,
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "uploaded_intake",
            "admitted_collection",
            "shared_analysis",
            "policy_evaluation",
            "human_decision",
            "registered_github_handoff"
          ],
          "title": "Kind",
          "type": "string"
        },
        "depends_on": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
            "type": "string"
          },
          "maxItems": 50,
          "title": "Depends On",
          "type": "array"
        },
        "refs": {
          "additionalProperties": {
            "$ref": "#/$defs/Ref"
          },
          "propertyNames": {
            "enum": [
              "artifact",
              "report",
              "binding",
              "decision"
            ]
          },
          "title": "Refs",
          "type": "object"
        },
        "target_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Id"
        },
        "authorization_kind": {
          "anyOf": [
            {
              "enum": [
                "advisory_request",
                "exact_plan"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Authorization Kind"
        },
        "parameters": {
          "additionalProperties": {
            "maximum": 9007199254740991,
            "minimum": 1,
            "type": "integer"
          },
          "propertyNames": {
            "enum": [
              "max_artifact_bytes",
              "timeout_seconds"
            ]
          },
          "title": "Parameters",
          "type": "object"
        }
      },
      "required": [
        "id",
        "kind",
        "depends_on",
        "refs"
      ],
      "title": "Step",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "default": 1,
      "maximum": 1,
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "project_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
      "title": "Project Id",
      "type": "string"
    },
    "workspace_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
      "title": "Workspace Id",
      "type": "string"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/Step"
      },
      "maxItems": 50,
      "minItems": 1,
      "title": "Steps",
      "type": "array"
    }
  },
  "required": [
    "project_id",
    "workspace_id",
    "steps"
  ],
  "title": "Workflow",
  "type": "object"
}
