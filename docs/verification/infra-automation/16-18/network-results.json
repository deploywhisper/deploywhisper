  "observation_code": "import hashlib,json,os,signal,socket,time\nfrom pathlib import Path\n\ndef expired(*args):\n    raise TimeoutError()\n\ndef namespace(path):\n    try:\n        return {\"inode\":os.stat(path).st_ino,\"accessible\":True}\n    except PermissionError:\n        return {\"accessible\":False,\"reason\":\"permission_denied\"}\n\nstatus={}\nfor line in Path(\"/proc/self/status\").read_text().splitlines():\n    key,_,value=line.partition(\":\")\n    if key in {\"Uid\",\"Gid\",\"CapEff\",\"NoNewPrivs\",\"Seccomp\",\"Seccomp_filters\"}:\n        status[key]=value.strip()\nvalue={\"uid\":os.getuid(),\"gid\":os.getgid(),\"status\":status,\"host\":\"example.com\",\"port\":443,\"self_network_namespace\":namespace(\"/proc/self/ns/net\"),\"pid1_network_namespace\":namespace(\"/proc/1/ns/net\"),\"interfaces\":sorted(os.listdir(\"/sys/class/net\")),\"route_v4\":Path(\"/proc/net/route\").read_text(),\"resolver_config_digest\":\"sha256:\"+hashlib.sha256(Path(\"/etc/resolv.conf\").read_bytes()).hexdigest()}\nsignal.signal(signal.SIGALRM,expired)\nstarted=time.monotonic()\nsignal.alarm(8)\ntry:\n    addresses=socket.getaddrinfo(\"example.com\",443,type=socket.SOCK_STREAM)\n    value.update(outcome=\"resolved\",address_count=len(addresses))\nexcept socket.gaierror as error:\n    value.update(outcome=\"resolver_denied\",gai_errno=error.errno)\nexcept TimeoutError:\n    value.update(outcome=\"bounded_timeout\")\nfinally:\n    signal.alarm(0)\nvalue[\"elapsed_seconds\"]=time.monotonic()-started\nprint(json.dumps(value,sort_keys=True))\n",
