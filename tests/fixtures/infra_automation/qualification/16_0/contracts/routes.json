  "special_rules": {
    "cancel": "requester owner with cancellation capability or scoped admin; machines need separately assigned cancellation capability",
    "decide": "shared requester excluded; server-configured single-operator acknowledgement allowed without independent-review claim",
    "webhook": "HMAC/timestamp/nonce replay proof before scheduling; never human decision",
    "runner": "claim requires exact task grant; server owns all task scope fields",
    "receiver": "one-use consume + live bound authority; acceptance is nonterminal",
    "read": "signed cursors are scope/principal/filter/snapshot bound; share links/role headers denied"
  }
